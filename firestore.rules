rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Canonical path (Plural)
    match /leaderboards/{runId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.userId
                    && request.resource.data.isDevTuned == false
                    && request.resource.data.highScore is int
                    && request.resource.data.highScore >= 0
                    && request.resource.data.highScore <= 10000000
                    && request.resource.data.maxWave is int
                    && request.resource.data.maxWave >= 1
                    && request.resource.data.maxWave <= 1000
                    && request.resource.data.username is string
                    && request.resource.data.username.size() >= 3
                    && request.resource.data.username.size() <= 20
                    && request.resource.data.keys().hasAll(['userId', 'username', 'highScore', 'maxWave', 'timestamp', 'isDevTuned', 'clientVersion']);
      allow update, delete: if false;
    }

    // Legacy path (Singular) - Identical validation to prevent 403s on legacy builds
    match /leaderboard/{scoreId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.userId
                    && request.resource.data.isDevTuned == false
                    && request.resource.data.highScore is int
                    && request.resource.data.highScore >= 0
                    && request.resource.data.highScore <= 10000000
                    && request.resource.data.maxWave is int
                    && request.resource.data.maxWave >= 1
                    && request.resource.data.maxWave <= 1000
                    && request.resource.data.username is string
                    && request.resource.data.username.size() >= 3
                    && request.resource.data.username.size() <= 20
                    && request.resource.data.keys().hasAll(['userId', 'username', 'highScore', 'maxWave', 'timestamp', 'isDevTuned', 'clientVersion']);
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
