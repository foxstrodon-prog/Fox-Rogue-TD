# ==============================================================================
# Git Attributes - Dual Front TD
# Enforces cross-platform line endings and binary handling across Windows/Linux/macOS
# ==============================================================================

# Default: auto-detect text files and normalize to LF in repository
* text=auto eol=lf

# ------------------------------------------------------------------------------
# Source Code & Text Assets (Always LF)
# ------------------------------------------------------------------------------
*.kt text eol=lf diff=kotlin
*.java text eol=lf diff=java
*.kts text eol=lf
*.gradle text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.properties text eol=lf
*.rules text eol=lf
*.fcpxml text eol=lf
*.edl text eol=lf
*.cs text eol=lf diff=csharp

# ------------------------------------------------------------------------------
# Scripts (Platform-specific line endings)
# ------------------------------------------------------------------------------
*.sh text eol=lf
gradlew text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
gradlew.bat text eol=crlf
*.ps1 text eol=crlf

# ------------------------------------------------------------------------------
# Binary Assets (Never diff, never normalize line endings)
# ------------------------------------------------------------------------------
*.apk binary
*.aab binary
*.exe binary
*.dll binary
*.so binary
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.wav binary
*.mp3 binary
*.ogg binary
*.zip binary
*.tar.gz binary
