# ==============================================================================
# Template: .env.example
# Copy this file to '.env' and populate with your local values.
# '.env' is git-ignored and should NEVER be committed.
# ==============================================================================

# Gemini AI API Key (Optional):
# Used for optional generative AI features or prompt agents.
# GEMINI_API_KEY=your_gemini_api_key_here

# Firebase AppCheck Debug Token (Optional):
# FIREBASE_APPCHECK_DEBUG_TOKEN=your_debug_token_here

# Leaderboard REST Backend Settings (Alternative to local.properties):
# LEADERBOARD_PROJECT_ID=your_firestore_project_id
# LEADERBOARD_API_KEY=your_firestore_api_key
# LEADERBOARD_COLLECTION=leaderboard
